# Dependencies
node_modules/

# Build output
dist/

# Environment
.env
.env.*
!.env.example

# npm auth + pack artifacts (never commit tokens)
.npmrc
*.tgz

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Temp files
tmp/
*.tmp
*.log

# Coverage
coverage/

# tesseract.js OCR language data (downloaded to cwd at runtime)
*.traineddata

# Source maps
*.js.map

# Skilld references (recreated by `skilld install`)
.skilld/

# Locally generated dev skills (skilld) — machine-local, never part of the repo.
# They carry no `metadata.internal` marker, so tracking them would expose them to
# `npx skills add`; the project's own internal skill uses that marker instead.
.claude/skills/*-skilld/

# Generated test-clip cache (test/helpers/golden-clips.ts) — regenerable, never committed
.cache/
